# Servicio systemd de sistema para Kaitosan.
# Instalar en /etc/systemd/system/kaito.service, luego:
#   sudo systemctl daemon-reload && sudo systemctl enable --now kaito
#
# Nota: el usuario de este equipo es "kaitosan" y el checkout vive en
# /home/kaitosan/robot (el PLAN_AJUSTES.md usa "kaito" / "/home/kaito/kaitosan"
# como marcador; §1 dice ajustar el nombre).

[Unit]
Description=Kaitosan
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=kaitosan
SupplementaryGroups=audio video bluetooth
WorkingDirectory=/home/kaitosan/robot
ExecStart=/home/kaitosan/robot/venv/bin/python app.py
Restart=on-failure
KillSignal=SIGTERM
TimeoutStopSec=20

# --- Límites de CPU / temperatura (Pi 4 con disipador pasivo) ---
# Un solo hilo para las librerías nativas (ONNX Runtime, OpenBLAS, OpenCV):
# evita que cada inferencia del wakeword y cada frame de detección se repartan
# entre los 4 núcleos y disparen la temperatura.
# Sin búfer en stdout: los print() de la conversación llegan al journal al vuelo.
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OPENCV_FOR_THREADS_NUM=1
# Tope duro: como mucho ~2 núcleos de los 4. Deja siempre 2 libres para el
# kiosco (Chromium) y el sistema, y corta de raíz el escenario "314% clavado".
CPUQuota=200%
# Menos prioridad que el resto para que, si compite, ceda antes.
Nice=5

[Install]
WantedBy=multi-user.target
