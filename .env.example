GROQ_API_KEY=tu_api_key_de_groq
GEMINI_API_KEY=xxxx
TAVILY_API_KEY=tu_clave_aqui
# Usuario y contraseña del panel. Solo semilla inicial: en el primer arranque se
# guardan (con hash) en la BD y luego se cambian desde Ajustes.
ADMIN_USER=laura
ADMIN_PASSWORD=tu_contraseña_admin
FLASK_SECRET_KEY=una_clave_secreta_aleatoria
# Modo debug del servidor Flask-SocketIO (true/false). El reloader queda siempre
# desactivado para no duplicar cámara/detector/voz bajo systemd.
FLASK_DEBUG=true

# Azure Speech (evaluación de pronunciación en modo sensei). Tier gratuito F0:
# 5 h de audio STT/pronunciación al mes. Si se agota, cae a Groq Whisper.
# Dejar AZURE_SPEECH_KEY vacío desactiva Azure por completo.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=francecentral
# Límite mensual en segundos con margen de seguridad (5 h = 18000; por defecto 4 h 40 m).
AZURE_STT_LIMITE_SEG_MES=16800
# Volcar en consola el JSON completo de evaluación de Azure (depuración).
AZURE_PRON_DEBUG=false
# Tolerancia de la evaluación (Azure ja-JP es duro con la 'r' española):
# una palabra solo cuenta como fallo por debajo de este umbral; a partir del
# umbral BIEN (global) sin fallos reales, el veredicto es BIEN.
AZURE_PRON_UMBRAL_PALABRA=40
AZURE_PRON_UMBRAL_BIEN=75
# Evaluar pronunciación también en el modo charla (gasta cuota más rápido). Por defecto solo en modo estudio.
AZURE_PRON_EN_CHARLA=false

# Audio: forzar dispositivo por subcadena del nombre (vacío = autodetección).
# Ej.: AUDIO_OUTPUT_HINT=G435 para oír por los cascos en vez de la hifiberry.
AUDIO_OUTPUT_HINT=
AUDIO_INPUT_HINT=

# Ajustes de la Pi (panel /admin/ajustes). Fuera de Linux siempre se usan datos
# de ejemplo; pon AJUSTES_FAKE=1 para forzar ese modo simulado también en la Pi.
AJUSTES_FAKE=
# Control del mezclador ALSA para leer/ajustar el volumen (vacío = autodetección:
# Master → PCM → Speaker → …). Ej.: AJUSTES_MIXER_CONTROL=Digital
AJUSTES_MIXER_CONTROL=
# PIN para el reset de fábrica del panel (Ajustes → Mantenimiento). Se usa solo
# mientras no haya un pin_hash guardado en la BD. Por defecto: 1234
AJUSTES_RESET_PIN=

# Pausa (segundos) entre trozos de voz al alternar español/japonés.
# Súbelo si lo dice demasiado seguido; ponlo a 0 para que vaya del tirón.
TTS_PAUSA_SEGMENTOS=0.3
# Silencio (segundos) al principio del todo, para que no arranque de golpe.
TTS_SILENCIO_INICIAL=0.15

# Modo sensei: modelo del profesor y esfuerzo de razonamiento (solo aplica a gpt-oss).
# Si gpt-oss se enrolla o responde en japonés, prueba MODEL_SENSEI=qwen/qwen3.8-27b.
MODEL_SENSEI=openai/gpt-oss-120b
REASONING_EFFORT_SENSEI=low

# WAKEWORD_DEBUG=true escribe en los logs la puntuación de cada ventana del
# detector de wake word (para ver si te oye aunque no llegue al umbral).
WAKEWORD_DEBUG=false
# Cada cuántos frames de 80 ms se infiere. 3 = cada 240 ms (~1/3 de CPU que
# infiriendo en cada frame; +160 ms de latencia, imperceptible). Sube a 4-5 si
# la Pi sigue caliente; baja a 1 si notas que se pierden activaciones.
WAKEWORD_HOP_FRAMES=3
# Núcleos que ONNX Runtime usa por inferencia del wakeword. 1 evita clavar la CPU.
WAKEWORD_ORT_THREADS=1
